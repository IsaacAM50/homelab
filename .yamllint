---
# Alineado con lo que exige ansible-lint: si estos valores no coinciden,
# ansible-lint avisa y desactiva su modo de autocorrección.
extends: default
ignore: |
  .github/
rules:
  line-length:
    max: 120
    level: warning
  truthy:
    allowed-values: ["true", "false"]
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
